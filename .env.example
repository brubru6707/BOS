# Firebase configuration for the "interested in joining" form on /projects.
#
# These NEXT_PUBLIC_* values are safe to expose publicly — Firebase web API keys
# are meant for client-side code, and access is enforced through Firestore
# Security Rules, not through key secrecy.
#
# Copy this file to `.env.local` and fill in the values from your own Firebase
# project (console.firebase.google.com -> Project settings -> Your apps).
#
# You only need these if you're working on the interest form. Every other page
# runs fine with them left blank.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
